# ==========================================
# KIVO PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# PLATFORM & APP
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Kivo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="replace-with-a-very-long-random-string-min-32-chars"

# DATABASE (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kivo_db"

# REDIS (Optional for local dev, recommended for prod rate-limiting & caching)
REDIS_URL="redis://localhost:6379"

# AI PROVIDERS (Gateway Architecture)
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# META / WHATSAPP CLOUD API (Official Business API)
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""

# AUTHENTICATION & SESSIONS
JWT_SECRET="replace-with-a-jwt-secret-min-32-chars"
COOKIE_SECRET="replace-with-a-cookie-secret-min-32-chars"

# STORAGE / UPLOADS (Optional for Phase 1 local/memory storage)
UPLOAD_DIR="./public/uploads"